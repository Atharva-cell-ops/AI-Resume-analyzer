{
  "name": "ai-resume-analyzer-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Full Stack ATS Resume Builder and Analyzer",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:push": "npm run db:push --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  }
}
